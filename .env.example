# Copie este arquivo para .env e preencha com as chaves do seu projeto Supabase
# (Project Settings > API no painel do Supabase).
#
# Variáveis com prefixo EXPO_PUBLIC_ são embutidas no bundle do app — não
# coloque aqui nada além da URL e da anon key públicas.

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
